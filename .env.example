# Canonical origin for Auth emails/callbacks. Required HTTPS origin on Vercel; localhost is development-only.
APP_URL=http://localhost:3000
# Supabase Dashboard → Project Settings → API. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect → transaction pooler (port 6543), server-only runtime connection.
DATABASE_URL=
# Manual migration CLI only: direct connection, or session pooler (port 5432) on IPv4 hosts.
# Not needed by Vercel build/runtime; do not use the transaction pooler for migrations.
DIRECT_URL=
# Private bucket created manually in Supabase Storage. The app uses the fixed name pet-documents.
SUPABASE_STORAGE_BUCKET=pet-documents
# Server-only: generate at least 32 random characters. Required by the scheduled endpoint.
CRON_SECRET=
# Server-only: required for bounded upload verification, immutable publication, and cleanup.
# Never prefix this with NEXT_PUBLIC_. Browser grants and downloads remain session/ownership checked.
SUPABASE_SERVICE_ROLE_KEY=
