# Canonical app origin used for signup and password recovery emails. Use your HTTPS origin in production.
APP_URL=http://localhost:3000
# Supabase Dashboard → Project Settings → API. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect → transaction pooler (port 6543), server-only runtime connection.
DATABASE_URL=
# Supabase Connect → direct connection, or session pooler (port 5432) on IPv4 hosts.
DIRECT_URL=
# Reserved for Phase 2+ private document uploads; no upload endpoints exist yet.
SUPABASE_STORAGE_BUCKET=pet-documents
