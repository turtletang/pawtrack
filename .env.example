# Canonical app origin used for signup and password recovery emails. Use your HTTPS origin in production.
APP_URL=http://localhost:3000
# Supabase Dashboard → Project Settings → API. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect → transaction pooler (port 6543), server-only runtime connection.
DATABASE_URL=
# Supabase Connect → direct connection, or session pooler (port 5432) on IPv4 hosts.
DIRECT_URL=
# Private bucket created manually in Supabase Storage. The app uses the fixed name pet-documents.
SUPABASE_STORAGE_BUCKET=pet-documents
# Server-only: generate at least 32 random characters. Required by the scheduled endpoint.
CRON_SECRET=
# Server-only: Supabase service-role key, used ONLY by the cleanup worker.
# Never prefix this with NEXT_PUBLIC_. Uploads and signed URLs use the user's session + RLS.
SUPABASE_SERVICE_ROLE_KEY=
